# Copy to terraform.tfvars and fill in the two REPLACE values.
# Everything else has a sensible default; override only if needed.

# REQUIRED: who may reach the admin UI over HTTPS.
allowed_cidrs = ["REPLACE.WITH.YOUR.IP/32"]

# REQUIRED: contents of your SSH public key file.
ssh_public_key = "ssh-ed25519 AAAA...REPLACE user@host"


# MSSPs: one deployment per client. Prefixes every resource, tags it
# customer=<name>, and stops Terraform owning the subscription-wide Marketplace
# terms (accept them once with ../preflight-azure.sh ha --product asm --accept-terms).
# Set it on the first apply only. See docs/AZURE_MSSP_RUNBOOK.md.
# customer = "acme"

# Optional overrides:
# resource_group_name = "rg-hailbytes-asm-prod"
# location            = "northeurope"
# admin_username      = "hbadmin"
# environment         = "prod"
