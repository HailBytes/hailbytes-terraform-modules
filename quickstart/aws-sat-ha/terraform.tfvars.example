# Copy to terraform.tfvars. One value is required.

# REQUIRED: who may reach the admin console.
allowed_cidrs = ["REPLACE.WITH.YOUR.IP/32"]

# Who may reach the PHISHING/landing surface, as opposed to the admin console.
# Unset, it inherits allowed_cidrs above, which locks your simulation targets
# out of the landing pages unless they all sit inside that same range.
# phish_allowed_cidrs = ["0.0.0.0/0"]

# MSSPs: one deployment per client. Prefixes every resource and tags it
# customer=<name>. Set it on the first apply only. See docs/AWS_MSSP_RUNBOOK.md.
# customer = "acme"

# Your ACM certificate for the console hostname. Unset, a self-signed one is
# generated and browsers warn until you replace it.
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."

# On by default. Set false in its own apply before terraform destroy.
# deletion_protection = true

# Every vCPU meters $0.24/hour. The default is the module's, 8 vCPU per instance.
# instance_type = "m6i.2xlarge"

# Optional overrides:
# region      = "us-east-1"
# environment = "prod"
