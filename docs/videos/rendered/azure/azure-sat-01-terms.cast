[9.6, "o", "==============================================================\r\n"]
[9.635, "o", " HailBytes SAT \u2014 Azure preflight (ha tier)\r\n"]
[9.67, "o", "==============================================================\r\n"]
[9.705, "o", "\r\n"]
[9.74, "o", "Subscription : HailBytes Demo\r\n"]
[9.775, "o", "  id         : 00000000-0000-0000-0000-000000000000\r\n"]
[9.81, "o", "  signed in  : admin@example.com\r\n"]
[9.845, "o", "\r\n"]
[9.88, "o", "--------------------------------------------------------------\r\n"]
[9.915, "o", " Resource providers\r\n"]
[9.95, "o", "--------------------------------------------------------------\r\n"]
[9.985, "o", "  Microsoft.Compute                  Registered\r\n"]
[10.02, "o", "  Microsoft.Network                  Registered\r\n"]
[10.055, "o", "  Microsoft.Storage                  Registered\r\n"]
[10.09, "o", "  Microsoft.ManagedIdentity          NotRegistered\r\n"]
[10.125, "o", "  Microsoft.MarketplaceOrdering      NotRegistered\r\n"]
[10.16, "o", "  Microsoft.Insights                 Registered\r\n"]
[10.195, "o", "  Microsoft.OperationalInsights      NotRegistered\r\n"]
[10.23, "o", "  Microsoft.KeyVault                 Registered\r\n"]
[10.265, "o", "  Microsoft.DBforPostgreSQL          NotRegistered\r\n"]
[10.3, "o", "  Microsoft.Cache                    NotRegistered\r\n"]
[10.335, "o", "\r\n"]
[10.37, "o", "Registering 5 provider(s). This is a one-time,\r\n"]
[10.405, "o", "subscription-scoped, non-billable change and can take a few minutes.\r\n"]
[10.44, "o", "\r\n"]
[10.475, "o", "  registering Microsoft.ManagedIdentity      done\r\n"]
[10.51, "o", "  registering Microsoft.MarketplaceOrdering  done\r\n"]
[10.545, "o", "  registering Microsoft.OperationalInsights  done\r\n"]
[10.58, "o", "  registering Microsoft.DBforPostgreSQL      done\r\n"]
[10.615, "o", "  registering Microsoft.Cache                done\r\n"]
[15.078, "o", "\r\n"]
[15.113, "o", "--------------------------------------------------------------\r\n"]
[15.148, "o", " Marketplace image terms\r\n"]
[15.183, "o", "--------------------------------------------------------------\r\n"]
[15.218, "o", "Offer: lcmcon1687976613543:gophish-phishing-simulator:standard-v2\r\n"]
[15.253, "o", "  terms not accepted; accepting now (--accept-terms was passed)\r\n"]
[15.288, "o", "  accepted\r\n"]
[41.587, "o", "--------------------------------------------------------------\r\n"]
[41.622, "o", " Marketplace image in northeurope\r\n"]
[41.657, "o", "--------------------------------------------------------------\r\n"]
[41.692, "o", "  Active version(s): 1.2409.90\r\n"]
[41.727, "o", "  marketplace_image_version defaults to \"latest\", which resolves to\r\n"]
[41.762, "o", "  this. Pin it explicitly for a reproducible deployment.\r\n"]
[41.797, "o", "\r\n"]
[41.832, "o", "--------------------------------------------------------------\r\n"]
[41.867, "o", " Availability zones in northeurope\r\n"]
[41.902, "o", "--------------------------------------------------------------\r\n"]
[41.937, "o", "  Standard_D2s_v3 is offered in zones: 1 2 3\r\n"]
[41.972, "o", "\r\n"]
[42.007, "o", "--------------------------------------------------------------\r\n"]
[42.042, "o", " Compute quota in northeurope\r\n"]
[42.077, "o", "--------------------------------------------------------------\r\n"]
[42.112, "o", "The ha tier builds 2 application VM(s) at Standard_D2s_v3\r\n"]
[42.147, "o", "(2 vCPUs each), so it needs 4 vCPUs of\r\n"]
[42.182, "o", "'standardDSv3Family' quota here.\r\n"]
[42.217, "o", "The Flexible Server and the Redis cache draw their own quotas, separate\r\n"]
[42.252, "o", "from this one.\r\n"]
[42.287, "o", "\r\n"]
[42.322, "o", "  standardDSv3Family: 0 used of 10 \u2014 10 available.\r\n"]
[42.357, "o", "  Sufficient for the default sizing.\r\n"]
[42.392, "o", "\u001b[2m  ...\u001b[0m\r\n"]
[42.427, "o", "==============================================================\r\n"]
[42.462, "o", " Preflight complete for the ha tier in northeurope.\r\n"]
[42.497, "o", "==============================================================\r\n"]
