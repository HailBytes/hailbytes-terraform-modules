[137.396, "o", "  \u001b[32m+\u001b[0m resource \"azurerm_resource_group\" \"main\" {\r\n"]
[137.431, "o", "      \u001b[32m+\u001b[0m name     = \"rg-acme-sat-prod\"\r\n"]
