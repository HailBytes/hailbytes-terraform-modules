[4.964, "o", "\r\n"]
[5.214, "o", "\r\n"]
[5.249, "o", "\u001b[1mHailBytes guided deployment\u001b[0m\r\n"]
[5.284, "o", "\u001b[2mDeploys HailBytes SAT or ASM into your own cloud account from the published\u001b[0m\r\n"]
[5.319, "o", "\u001b[2mMarketplace image, using the open-source Terraform modules in github.com/HailBytes/hailbytes-terraform-modules.\u001b[0m\r\n"]
[5.354, "o", "\u001b[2mNothing is created until you confirm a plan.\u001b[0m\r\n"]
[5.389, "o", "\r\n"]
[5.424, "o", "\u001b[32m\u2713\u001b[0m Detected azure Cloud Shell\r\n"]
[5.459, "o", "\r\n"]
[5.494, "o", "\u001b[1mPrerequisites\u001b[0m\r\n"]
[5.529, "o", "\u001b[32m\u2713\u001b[0m terraform 1.9.8\r\n"]
[5.564, "o", "\u001b[32m\u2713\u001b[0m Azure subscription: HailBytes Demo (00000000-0000-0000-0000-000000000000)\r\n"]
[5.599, "o", "\r\n"]
[5.634, "o", "\u001b[1mWhich product are you deploying?\u001b[0m\r\n"]
[5.669, "o", "  \u001b[36m1)\u001b[0m HailBytes SAT \u2014 phishing simulation and security awareness training\r\n"]
[5.704, "o", "  \u001b[36m2)\u001b[0m HailBytes ASM \u2014 attack surface management\r\n"]
[6.339, "o", "Choice [1-2]: "]
[7.139, "o", "1"]
[7.211, "o", "\r\n"]
[7.461, "o", "\r\n"]
[7.496, "o", "\u001b[1mWhich deployment shape?\u001b[0m\r\n"]
[7.531, "o", "  \u001b[36m1)\u001b[0m Single VM \u2014 one instance, local database. Dev, PoC, small org.\r\n"]
[7.566, "o", "  \u001b[36m2)\u001b[0m HA hot-hot \u2014 two instances across zones, managed database, shared cache.\r\n"]
[7.601, "o", "  \u001b[36m3)\u001b[0m Unlimited scale \u2014 autoscaling instance group, managed database + read replicas.\r\n"]
[8.236, "o", "Choice [1-3]: "]
[9.036, "o", "2"]
[9.107, "o", "\r\n"]
[9.357, "o", "\r\n"]
[9.392, "o", "\u001b[33m\u250c\u2500 COST IMPACT \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n"]
[9.427, "o", "\u001b[33m\u2502\u001b[0m HA is roughly 2.8x the all-in cost of a single VM.\r\n"]
[9.462, "o", "\u001b[33m\u2502\u001b[0m   It is not 2x: HA adds a zone-redundant database (billed at 2x compute\r\n"]
[9.497, "o", "\u001b[33m\u2502\u001b[0m   AND 2x storage for the standby), a shared cache, and a load balancer.\r\n"]
[9.532, "o", "\u001b[33m\u2502\u001b[0m\r\n"]
[9.567, "o", "\u001b[33m\u2502\u001b[0m   At 2-vCPU instances in North Europe that is about $1,432/month all-in\r\n"]
[9.602, "o", "\u001b[33m\u2502\u001b[0m   against $514 for a single VM. See AZURE_COST_SHAPES.md for the\r\n"]
[9.637, "o", "\u001b[33m\u2502\u001b[0m   line-by-line breakdown and the levers that reduce it.\r\n"]
[9.672, "o", "\u001b[33m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n"]
[13.774, "o", "\u001b[36mUnderstood \u2014 continue with HA?\u001b[0m [y/N]: "]
[14.574, "o", "y"]
[14.645, "o", "\r\n"]
[15.895, "o", "\u001b[2J\u001b[H"]
[16.095, "o", "\u001b[1mHow many vCPUs per application node?\u001b[0m\r\n"]
[16.13, "o", "  \u001b[36m1)\u001b[0m Pilot - 2 vCPU. THE DEFAULT. Evaluation, demos and small rosters\r\n"]
[16.165, "o", "  \u001b[36m2)\u001b[0m Departmental - 4 vCPU. Steady multi-team use\r\n"]
[16.2, "o", "  \u001b[36m3)\u001b[0m Organisational - 8 vCPU. The published purchasable rung\r\n"]
[16.235, "o", "  \u001b[36m4)\u001b[0m Larger - 16 vCPU\r\n"]
[16.87, "o", "Choice [1-4]: "]
[17.67, "o", "1"]
[17.742, "o", "\r\n"]
[17.992, "o", "\u001b[32m\u2713\u001b[0m Each application node will be Standard_D2s_v3 (2 vCPU).\r\n"]
[18.027, "o", "\u001b[2mChanging this later REPLACES the VM. On the HA pair that is a rolling\u001b[0m\r\n"]
[18.062, "o", "\u001b[2mreplacement one node at a time; on a single VM it is downtime. Pick the\u001b[0m\r\n"]
[18.097, "o", "\u001b[2msize you expect to run at, not the smallest one that starts.\u001b[0m\r\n"]
[18.132, "o", "\r\n"]
[18.167, "o", "\u001b[33m\u250c\u2500 COST IMPACT \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n"]
[18.202, "o", "\u001b[33m\u2502\u001b[0m The HailBytes software meters per vCPU-hour, across every node.\r\n"]
[18.237, "o", "\u001b[33m\u2502\u001b[0m   2 node(s) x 2 vCPU = 4 metered vCPUs, roughly\r\n"]
[18.272, "o", "\u001b[33m\u2502\u001b[0m   $701/month for the software alone,\r\n"]
[18.307, "o", "\u001b[33m\u2502\u001b[0m   before any cloud infrastructure charges.\r\n"]
[18.342, "o", "\u001b[33m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n"]
[25.843, "o", "\u001b[36mKeep Standard_D2s_v3?\u001b[0m [y/N]: "]
[26.643, "o", "y"]
[26.715, "o", "\r\n"]
[27.965, "o", "\u001b[2m  ...\u001b[0m\r\n"]
[28.0, "o", "\u001b[2mYou must also supply the network inputs (vm_subnet_id, lb_subnet_id,\u001b[0m\r\n"]
[28.035, "o", "\u001b[2mdb_delegated_subnet_id, private_dns_zone_id). quickstart/azure-ha shows a\u001b[0m\r\n"]
[28.07, "o", "\u001b[2mroot config that creates them with modules/network/azure.\u001b[0m\r\n"]
[28.705, "o", "\u001b[36mRun terraform init and plan now?\u001b[0m [y/N]: "]
[29.505, "o", "n"]
[29.576, "o", "\r\n"]
[29.826, "o", "\u001b[32m\u2713\u001b[0m Configuration written to /home/admin/hailbytes-deploy. Run terraform there when ready.\r\n"]
